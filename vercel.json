
{
  "version": 2,
  "buildCommand": "npm run build:ssr",
  "outputDirectory": "dist/LearnGround/browser",
  "functions": {
    "api/ssr.ts": {
      "includeFiles": "dist/**"
    },
    "api/keep-alive.ts": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*\\..*)", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/api/ssr" }
  ]
}
